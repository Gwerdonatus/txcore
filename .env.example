# TxCore Environment Configuration
# Copy this file to .env and fill in your values
# Never commit .env to version control

# Django
SECRET_KEY=your-secret-key-here-generate-with-python-secrets
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,web

# Database
DB_NAME=txcore
DB_USER=txcore
DB_PASSWORD=txcore
DB_HOST=localhost
DB_PORT=5432

# Redis
REDIS_URL=redis://localhost:6379/0

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Webhook signing secret (used for HMAC-SHA256 validation)
WEBHOOK_SECRET=your-webhook-secret-here

# Compose host ports (services communicate on the private Compose network)
API_PORT=8100
KAFKA_PORT=19092
PROMETHEUS_PORT=9091
GRAFANA_PORT=3010

# Stripe sandbox only; never commit credentials.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CHECKOUT_RETURN_URL=http://localhost:8100/payments/return/
